# Mock upstream ports
VENDOR_PORT=4001
MEMBERSHIP_PORT=4002
# Credentials the mocks will accept (must match the bridge's .env)
VENDOR_API_KEY=demo-vendor-key
VENDOR_PARTNER_ID=fanclub-partner-001
MEMBERSHIP_API_KEY=demo-membership-key
# SQLite file
DB_PATH=./data/demo.db
# Artificial latency on every mock response. Set above the bridge's
# UPSTREAM_TIMEOUT_MS to see its 504 UPSTREAM_TIMEOUT handling.
MOCK_LATENCY_MS=0
# Where the e2e script finds the bridge
BRIDGE_URL=http://localhost:3000