{
  "name": "fanclub-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Seeded SQLite demo DB + mock Ticket Vendor and Membership APIs for the Fanclub Ticketing Bridge",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:fresh": "tsx src/server.ts --reset",
    "dev": "npx tsx watch src/server.ts",
    "db:reset": "tsx src/db/seed.ts",
    "e2e": "tsx src/e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.5"
  }
}