{
  "name": "show-stop-sandbox",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "demo": "tsx scripts/sandbox.ts",
    "typecheck": "npm run typecheck --prefix fanclub-demo && npm run typecheck --prefix fanclub-ticketing-bridge && npm run typecheck --prefix frontend && tsc --noEmit -p tsconfig.json",
    "build": "npm run build --prefix fanclub-ticketing-bridge && npm run build --prefix frontend",
    "test": "tsx scripts/sandbox.ts --test",
    "demo:built": "tsx scripts/sandbox.ts --built",
    "format": "prettier --write frontend/src scripts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^4.6.7",
    "bwip-js": "^4.11.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.0.5",
    "prettier": "^3.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
